<?xml version="1.0" encoding="UTF-8"?>
<!--
  Схема пространства имён http://v8.1c.ru/8.3/xcf/predef
  корневой элемент PredefinedData, поколение выгрузки 2.22.

  ВНИМАНИЕ: этот формат СВОЕГО атрибута version может не нести —
  тогда поколение унаследовано от описателя-родителя и означает
  «в выгрузке какого поколения файл наблюдался», а НЕ версию этого
  формата.

  ПОРОЖДЕНО из корпуса выгрузок, не является официальной схемой 1С.
  Дата порождения: 2026-08-09
  Файлов в основе: 45, видов/веток: 1
  Корней в корпусе: 2

  ХАРАКТЕР АРТЕФАКТА — ОПИСАТЕЛЬНЫЙ, НЕ НОРМАТИВНЫЙ.
  Схема фиксирует то, что встретилось в корпусе, а не то, что допускает
  формат. Модель содержимого намеренно разрешительная (xs:choice без
  порядка и кратностей). Применение:
    можно  — находить поля, обнаруживать незнакомые элементы;
    нельзя — отбраковывать файлы: законный, но не встретившийся в корпусе
             элемент дал бы ложную ошибку.

  Поддеревья чужих пространств имён (v8:, xr:, logform, DCS, predef…)
  не раскрываются — у них собственные артефакты; здесь xs:any.

  Регенерация входит в тесты: породить заново и сравнить с этим файлом.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://v8.1c.ru/8.3/xcf/predef"
           targetNamespace="http://v8.1c.ru/8.3/xcf/predef"
           elementFormDefault="qualified">

  <xs:element name="PredefinedData" type="xs:anyType" nillable="true"/>

  <!-- Типы своего пространства, названные через xsi:type. Импортировать
       собственный targetNamespace нельзя, поэтому объявлены здесь —
       разрешительно, как заглушки: содержимое не описывается. -->
  <xs:complexType name="CatalogPredefinedItems" mixed="true">
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>
  <xs:complexType name="PlanOfCharacteristicKindPredefinedItems" mixed="true">
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="t_PredefinedData" mixed="true">
    <xs:annotation>
      <xs:documentation>путь: PredefinedData; встречено: 90</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Item" type="t_PredefinedData.Item" nillable="true"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string"/>
    <xs:anyAttribute namespace="##other" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="t_PredefinedData.Item" mixed="true">
    <xs:annotation>
      <xs:documentation>путь: PredefinedData.Item; встречено: 2412</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="ChildItems" type="t_PredefinedData.Item.ChildItems" nillable="true"/>
        <xs:element name="Code" type="xs:anyType" nillable="true"/>
        <xs:element name="Description" type="t_PredefinedData.Item.Description" nillable="true"/>
        <xs:element name="IsFolder" type="t_PredefinedData.Item.IsFolder" nillable="true"/>
        <xs:element name="Name" type="t_PredefinedData.Item.Name" nillable="true"/>
        <xs:element name="Type" type="t_PredefinedData.Item.Type" nillable="true"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string"/>
    <xs:anyAttribute namespace="##other" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="t_PredefinedData.Item.ChildItems" mixed="true">
    <xs:annotation>
      <xs:documentation>путь: PredefinedData.Item.ChildItems; встречено: 50</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Item" type="t_PredefinedData.Item" nillable="true"/>
      </xs:choice>
    </xs:sequence>
    <xs:anyAttribute namespace="##other" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="t_PredefinedData.Item.Code">
    <xs:annotation>
      <xs:documentation>путь: PredefinedData.Item.Code; встречено: 2412</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:anyAttribute namespace="##other" processContents="skip"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="t_PredefinedData.Item.Description">
    <xs:annotation>
      <xs:documentation>путь: PredefinedData.Item.Description; встречено: 2412</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:anyAttribute namespace="##other" processContents="skip"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="t_PredefinedData.Item.IsFolder">
    <xs:annotation>
      <xs:documentation>путь: PredefinedData.Item.IsFolder; встречено: 2412</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:anyAttribute namespace="##other" processContents="skip"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="t_PredefinedData.Item.Name">
    <xs:annotation>
      <xs:documentation>путь: PredefinedData.Item.Name; встречено: 2412</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:anyAttribute namespace="##other" processContents="skip"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="t_PredefinedData.Item.Type" mixed="true">
    <xs:annotation>
      <xs:documentation>путь: PredefinedData.Item.Type; встречено: 94</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <!-- чужие пространства имён: {http://v8.1c.ru/8.1/data/core}Type -->
        <xs:any namespace="##other" processContents="skip"/>
      </xs:choice>
    </xs:sequence>
    <xs:anyAttribute namespace="##other" processContents="skip"/>
  </xs:complexType>

</xs:schema>
